# このファイルをコピーして "application-local.yml" という名前で使ってください
# (application-local.ymlはgit管理対象外)。
# 別の接続先に切り替えたい場合は、このファイルの値を書き換えるだけです。
spring:
  datasource:
    url: jdbc:postgresql://<DBホスト名>:<ポート>/<DB名>
    username: <ユーザー名>
    password: <パスワード>
    driver-class-name: org.postgresql.Driver

  security:
    oauth2:
      client:
        registration:
          okta:
            # Okta管理画面のアプリ「General」タブに表示される値
            client-id: <Client IDを入力>
            client-secret: <Client Secretを入力>
            scope: openid, profile, email
            # TESLA側の仕様(SSO連携先)に合わせて明示的に指定。
            # 未指定の場合、Spring Securityは既定でclient_secret_basicを使う。
            client-authentication-method: client_secret_post
        provider:
          okta:
            # Okta管理画面の Security > API > Authorization Servers > default
            # の「Issuer URI」
            issuer-uri: https://<あなたのOktaドメイン>/oauth2/default

logging:
  level:
    com.example.backend: DEBUG
    com.example.backend.mapper: DEBUG

app:
  cors:
    # フロントエンド(Next.js開発サーバー)からのアクセスを許可
    allowed-origins: http://localhost:3000
  # フロントエンドのURL。ログイン成功後・ログアウト後、両方ともここへ戻す
  # (Oktaの「Sign-out redirect URIs」に
  # 登録したものと完全に一致させること)
  frontend-base-url: http://localhost:3000
