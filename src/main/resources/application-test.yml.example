# このファイルをコピーして "application-test.yml" という名前で使ってください
# (application-test.ymlはgit管理対象外)。
#
# 自動テスト(*MapperTest)専用の接続先。開発用DB(192.168.20.246等)とは
# 完全に別の、ローカルPC上にインストールしたPostgreSQLを指すこと。
# テストの実行によってデータが書き込まれる/削除されるため、
# 実データが入っている環境には絶対に向けないこと。
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/plex_test
    username: postgres
    password: <ローカルPostgreSQLのパスワード>
    driver-class-name: org.postgresql.Driver

  security:
    oauth2:
      client:
        # Mapperの統合テストは実際にOktaへログインするわけではないが、
        # SecurityConfigがOAuth2の設定Beanを必要とするため、
        # (ダミーでよいので)値を入れておかないとSpringのコンテキスト起動に失敗する。
        # application-local.ymlと同じ値をそのまま使って問題ない。
        registration:
          okta:
            client-id: <Client IDを入力(local用と同じ値でよい)>
            client-secret: <Client Secretを入力(local用と同じ値でよい)>
            scope: openid, profile, email
        provider:
          okta:
            issuer-uri: https://<あなたのOktaドメイン>/oauth2/default

app:
  # SecurityConfigが要求するため、ダミーでよいので入れておく必要がある
  frontend-base-url: http://localhost:3000
