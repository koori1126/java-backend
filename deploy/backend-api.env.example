# /opt/backend-api/backend-api.env としてVM上に配置するファイルの雛形。
# 実際の値に書き換えた上で、chmod 600 等でアクセス権を絞ってください。
# (このファイル自体はgit管理対象外にすること)

SPRING_PROFILES_ACTIVE=prod

DB_HOST=your-edb-host.internal
DB_PORT=5444
DB_NAME=your_db_name
DB_USERNAME=your_username
DB_PASSWORD=your_password

SERVER_PORT=8080

# JVMのヒープサイズ等を調整したい場合はここではなくsystemdのExecStart側、
# もしくは JAVA_TOOL_OPTIONS で指定
# JAVA_TOOL_OPTIONS=-Xms512m -Xmx1024m
