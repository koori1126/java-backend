# 【重要】このファイルはテンプレートです。実際に使う際は、
# Azure VM上の /opt/backend-api/config/application-prod.yml として配置してください。
# このファイル自体(実際の接続情報を書き込んだもの)は、
# 絶対にgitリポジトリにコミットしないこと。
#
# Spring Bootは、jarと同じ階層の config/ フォルダを自動的に読みに行くため、
# jar側・アプリコード側は一切変更せずに、この外部ファイルだけで
# DB接続情報を注入できます。
spring:
  datasource:
    url: jdbc:postgresql://<EDBのホスト名>:<ポート>/<DB名>
    username: <ユーザー名>
    password: <パスワード>
    driver-class-name: org.postgresql.Driver
    hikari:
      maximum-pool-size: 10
      minimum-idle: 2
      connection-timeout: 30000
