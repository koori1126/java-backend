# systemd ユニットファイル。
# 配置場所: /etc/systemd/system/backend-api.service
#
# 使い方:
#   sudo cp deploy/backend-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now backend-api
#
# 【設定ファイルについて】
# WorkingDirectory を /opt/backend-api にしているため、Spring Bootが
# 自動的に /opt/backend-api/config/application-prod.yml を読みに行きます。
# DB接続情報等の機密設定は、そちらの外部ファイルにのみ記載してください
# (jar・gitリポジトリには一切含まれません)。
#
[Unit]
Description=Backend API (Spring Boot)
After=network.target

[Service]
Type=simple
User=backendapp
Group=backendapp

WorkingDirectory=/opt/backend-api
Environment=SPRING_PROFILES_ACTIVE=prod

# jarの配置先。デプロイのたびにこのパスへ新しいjarを配置する運用を想定
ExecStart=/usr/bin/java -jar /opt/backend-api/backend-api.jar

# 異常終了時は自動再起動
Restart=on-failure
RestartSec=5

# ログはjournalctlに集約される(標準出力/標準エラーがそのままjournalへ)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
